{
  "name": "vite-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/app.ts --outDir dist/server",
    "check": "npm run typecheck && npm run lint && npm run lint:tailwind && npm run format:check && npm run check:deadcode && npm run test && npm run build",
    "check:deadcode": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy:cf": "wrangler deploy",
    "dev": "vite",
    "docker:build": "docker build -t vite-hono:latest .",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "preview": "vite preview",
    "start": "node dist/server/app.js",
    "test": "vitest run",
    "test:client": "vitest run --project client",
    "test:server": "vitest run --project server",
    "test:setup": "playwright install chromium",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@libsql/client": "0.18.0",
    "@scalar/hono-api-reference": "0.12.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "antd": "6.6.3",
    "bcrypt-ts": "9.0.2",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "4.13.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@cloudflare/vite-plugin": "1.54.8",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.37",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vitest-browser-react": "2.3.0",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": "24.21.0"
  }
}
