{
  "name": "vp-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:test:e2e": "vp test run --project client --reporter=tap-flat --no-color",
    "agent:test:unit": "vp test run --project server --reporter=tap-flat --no-color",
    "agent:verify:gate": "vpr agent:verify:unit && vp build && vpr agent:test:e2e",
    "agent:verify:inner": "vpr typecheck && vp lint && vpr lint:tailwind",
    "agent:verify:unit": "vpr agent:verify:inner && vpr agent:test:unit",
    "check:deadcode": "knip",
    "check:fast": "vpr typecheck && vp lint && vpr agent:test:unit",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy:cf": "wrangler deploy",
    "docker:build": "docker build -t vp-hono:latest .",
    "lint:ci": "actionlint",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "routes:generate": "node scripts/generate-routes.ts",
    "scaffold:feature": "node scripts/scaffold-feature.ts",
    "start": "vp node dist/server/app.js",
    "test:setup": "playwright install chromium",
    "typecheck": "tsc -b --pretty false",
    "verify": "vp check && vpr lint:tailwind && vpr check:deadcode && vp test run && vp build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@hono/zod-openapi": "1.6.3",
    "@libsql/client": "0.18.0",
    "@scalar/hono-api-reference": "0.12.11",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "antd": "6.6.5",
    "bcrypt-ts": "9.0.2",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.40",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "knip": "6.40.0",
    "oxc-transform-react": "0.153.0",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vscode-languageserver-protocol": "3.18.4",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": "24.21.0"
  },
  "knip": {
    "ignore": [
      "src/client/routeTree.gen.ts"
    ],
    "ignoreBinaries": [
      "actionlint"
    ],
    "ignoreDependencies": [
      "@tailwindcss/language-server"
    ],
    "playwright": true
  }
}
