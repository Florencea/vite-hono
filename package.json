{
  "name": "vite-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/app.ts --outDir dist/server",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy:cf": "wrangler deploy",
    "dev": "node --watch --watch-path=src/server --watch-path=src/locales --watch-path=.env --watch-path=package.json src/server/app.ts",
    "docker:build": "docker build -t vite-hono:latest .",
    "docker:down": "docker-compose down",
    "docker:up": "docker-compose up -d --build",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "node dist/server/app.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@libsql/client": "0.18.0",
    "@scalar/hono-api-reference": "0.12.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "antd": "6.6.3",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hash-wasm": "4.12.0",
    "hono": "4.13.7",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.36",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": "24.20.0"
  }
}
