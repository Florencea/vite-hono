{
  "name": "vite-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:lint": "npm run agent:lint:eslint && npm run agent:lint:tailwind",
    "agent:lint:ci": "actionlint -no-color",
    "agent:lint:eslint": "eslint --no-color --no-inline-config --max-warnings 0",
    "agent:lint:eslint:fix": "eslint --fix --no-color --no-inline-config",
    "agent:lint:fix": "npm run agent:lint:eslint:fix && npm run agent:lint:tailwind:fix",
    "agent:lint:tailwind": "node scripts/lint-tailwind.ts",
    "agent:lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "agent:test:e2e": "vitest run --project client --reporter=tap-flat --no-color",
    "agent:test:unit": "vitest run --project server --reporter=tap-flat --no-color",
    "agent:typecheck": "tsc -b --pretty false",
    "agent:verify:gate": "npm run agent:verify:unit && npm run build && npm run agent:test:e2e",
    "agent:verify:inner": "npm run agent:typecheck && npm run agent:lint",
    "agent:verify:unit": "npm run agent:verify:inner && npm run agent:test:unit",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/app.ts --outDir dist/server",
    "check": "npm run typecheck && npm run lint && npm run lint:tailwind && npm run format:check && npm run check:deadcode && npm run test && npm run build",
    "check:deadcode": "knip",
    "check:fast": "npm run typecheck && npm run lint && npm run test:server",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy:cf": "wrangler deploy",
    "dev": "vite",
    "docker:build": "docker build -t vite-hono:latest .",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint",
    "lint:ci": "actionlint",
    "lint:fix": "eslint --fix",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "preview": "vite preview",
    "routes:generate": "node scripts/generate-routes.ts",
    "scaffold:feature": "node scripts/scaffold-feature.ts",
    "start": "node dist/server/app.js",
    "test": "vitest run",
    "test:client": "vitest run --project client",
    "test:server": "vitest run --project server",
    "test:setup": "playwright install chromium",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@libsql/client": "0.18.0",
    "@scalar/hono-api-reference": "0.12.5",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "antd": "6.6.5",
    "bcrypt-ts": "9.0.2",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "4.13.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@cloudflare/vite-plugin": "1.60.1",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "knip": "6.38.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "vitest-browser-react": "2.3.0",
    "vscode-languageserver-protocol": "3.18.3",
    "wrangler": "4.140.0"
  },
  "engines": {
    "node": "24.21.0"
  },
  "knip": {
    "ignoreBinaries": [
      "actionlint"
    ],
    "ignoreDependencies": [
      "@tailwindcss/language-server"
    ]
  }
}
