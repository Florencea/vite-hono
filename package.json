{
  "name": "vite-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/app.ts --outDir dist/server",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:deadcode && npm run build",
    "check:deadcode": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy:cf": "wrangler deploy",
    "dev": "node --watch --watch-path=src/server --watch-path=src/locales --watch-path=.env --watch-path=package.json src/server/app.ts",
    "docker:build": "docker build -t vite-hono:latest .",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "start": "node dist/server/app.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@libsql/client": "0.18.0",
    "@scalar/hono-api-reference": "0.12.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "antd": "6.6.3",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hash-wasm": "4.12.0",
    "hono": "4.13.7",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.36",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "engines": {
    "node": "24.20.0"
  }
}
