# Client and Server shared config
VITE_TITLE="Test Vite Hono"
VITE_WEB_BASE="/"
VITE_API_OPENAPI_DOC_ROUTE="/openapi"
VITE_API_ENDPOINT_RPC="/api"
VITE_OUTDIR="dist"

# Feature flags (1 = enable, 0 = disable)
ENABLE_CLIENT=1
ENABLE_SERVER=1
ENABLE_OPENAPI=1
ENABLE_TYPEGEN=1
ENABLE_COMPRESSION=1

# Server & deployment options
PORT=3000
CORS_ORIGIN="*" # Specify origin e.g. "http://localhost:5173" if cross-origin credentials/cookies are needed

# Database & session security
DATABASE_URL="file:./database.sqlite"
COOKIE_NAME="TestViteHono"
COOKIE_SECRET="a long secret at least 32 characters long" # Change to a random 32+ char secret in production
SESSION_TTL=604800                                        # 7 days in seconds
