# ==============================================================================
# Environment Configuration (Optional Overrides)
#
# This project follows a Zero-Config (零配置) architecture:
# - Local development and automated tests run out-of-the-box with NO .env required.
# - Application titles and static specifications are defined in src/client/config.ts.
# - Session cookie secrets are automatically generated and persisted in the database.
#
# Define variables below ONLY if you need to override default settings:
# ==============================================================================

# Session cookie signing secret (optional; auto-generated and persisted in DB if omitted)
# COOKIE_SECRET="a long secret at least 32 characters long"

# Database connection URL (defaults to "file:./database.sqlite")
# DATABASE_URL="file:./database.sqlite"

# Server listening port (defaults to 3000)
# PORT=3000

# CORS allowed origin (defaults to "*")
# CORS_ORIGIN="*"

# OpenAPI Spec & Scalar API Reference (defaults to 1; set to 0 to disable)
# ENABLE_OPENAPI=1
