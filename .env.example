# ==============================================================================
# Server Configuration (Required in .env)
# ==============================================================================

# Database connection URL (local SQLite or remote LibSQL / Turso)
DATABASE_URL="file:./database.sqlite"

# Cookie session signing secret (must be 32+ characters in production)
COOKIE_SECRET="a long secret at least 32 characters long"

# Server listening port
PORT=3000

# CORS allowed origin ("*" for fullstack same-origin, or explicit frontend URL)
CORS_ORIGIN="*"

# OpenAPI Spec & Scalar API Reference (1 to enable, 0 to disable)
ENABLE_OPENAPI=1

# ==============================================================================
# Client Configuration
# ==============================================================================

# Application title displayed in browser
VITE_TITLE="Test Vite Hono"

