# ==============================================================================
# Essential Configuration (Required)
# ==============================================================================

# Database connection URL (local SQLite or remote LibSQL / Turso)
DATABASE_URL="file:./database.sqlite"

# Cookie session signing secret (must be 32+ characters in production)
COOKIE_SECRET="a long secret at least 32 characters long"

# ==============================================================================
# Optional / Deployment Overrides (Defaults provided in code)
# ==============================================================================

# Server listening port (default: 3000)
PORT=3000

# CORS allowed origin (default: "*" for fullstack same-origin; specify URL if decoupled)
# CORS_ORIGIN="http://localhost:5173"

# OpenAPI Spec & Scalar API Reference (default: 1; set to 0 to disable in production)
# ENABLE_OPENAPI=1

# Application title displayed in browser and API Reference
VITE_TITLE="Test Vite Hono"
